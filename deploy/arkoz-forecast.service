[Unit]
Description=ARKOZ AI TimesFM Forecast Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arkoz
Group=arkoz
WorkingDirectory=/opt/arkoz-ai
EnvironmentFile=-/opt/arkoz-ai/.env
Environment=FORECAST_PROVIDER=timesfm
Environment=HOME=/var/lib/arkoz
Environment=HF_HOME=/var/lib/arkoz/huggingface
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/arkoz-ai/.venv/bin/python -m uvicorn app:app --app-dir /opt/arkoz-ai/forecast-service --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
